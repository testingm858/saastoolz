// SaaSToolz — Prisma Schema
//
// Backed by Postgres (Neon, provisioned via the Vercel marketplace
// integration). directUrl uses the unpooled connection string — Neon's
// pooled endpoint (used for normal query traffic via `url`) doesn't
// reliably support the prepared statements Prisma's migration engine needs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  plan          String    @default("FREE")
  credits       Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  subscription Subscription?
  toolUsages   ToolUsage[]
  jobs         Job[]
  invoices     Invoice[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Billing ─────────────────────────────────────────────────────────────────

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  plan                 String    @default("FREE")
  status               String    @default("ACTIVE")
  creditsMonthly       Int       @default(0)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ─── Tool Usage ──────────────────────────────────────────────────────────────

model ToolUsage {
  id           String   @id @default(cuid())
  userId       String?
  toolId       String
  category     String
  plan         String   @default("FREE")
  latencyMs    Int?
  success      Boolean  @default(true)
  creditsUsed  Int      @default(0)
  errorMessage String?
  // Populated from Vercel's edge geo headers (x-vercel-ip-*) — free, no
  // external lookup call needed. Absent in local dev, where those headers
  // don't exist.
  country      String?
  region       String?
  city         String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([toolId, createdAt])
  @@index([country])
  @@map("tool_usages")
}

// ─── Async Jobs ───────────────────────────────────────────────────────────────

model Job {
  id          String    @id @default(cuid())
  userId      String?
  toolId      String
  status      String    @default("QUEUED")
  priority    Int       @default(3)
  resultUrl   String?
  errorMsg    String?
  progress    Int       @default(0)
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("jobs")
}

// ─── Blog ────────────────────────────────────────────────────────────────────

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  coverImage  String?   // data: URL, uploaded from /admin/blog (see MAX_COVER_IMAGE_BYTES)
  content     String
  published   Boolean   @default(false)
  publishedAt DateTime?
  views       Int       @default(0)
  likes       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
  @@map("blog_posts")
}

// Per-tool engagement counters. Tools themselves are a static registry
// (src/lib/tools.ts), not a DB table, so this keys directly off tool id
// and is created lazily (upsert) on first view/like rather than seeded.
model ToolStats {
  toolId String @id
  views  Int    @default(0)
  likes  Int    @default(0)

  @@map("tool_stats")
}

// Anonymous like toggle, shared by blog posts and tools. visitorId is a
// random id stored in a first-party cookie (see src/lib/visitor.ts) — no
// account required to like something.
model Like {
  id         String   @id @default(cuid())
  targetType String
  targetId   String
  visitorId  String
  createdAt  DateTime @default(now())

  @@unique([targetType, targetId, visitorId])
  @@index([targetType, targetId])
  @@map("likes")
}

// ─── Advertising ─────────────────────────────────────────────────────────────

// Admin-managed ad placements. `code` is raw third-party embed HTML/JS
// (AdSense, Adsterra, PropellerAds, etc) pasted verbatim from the network's
// dashboard — rendered inside a sandboxed iframe (see AdFrame.tsx), not
// sanitized, since stripping <script> tags would defeat the point of an ad
// embed. `key` is derived from `page`+`position` (see src/lib/adPlacements.ts)
// and is what the actual page components look up. Only isAdminEmail-gated
// routes can write to this table, same trust boundary as the rest of /admin.
model AdSlot {
  id        String   @id @default(cuid())
  key       String   @unique
  page      String
  position  String
  code      String?
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("ad_slots")
}

// Admin-managed "what's new" notices shown in a dismissible banner on the
// homepage — e.g. "Invoice Generator just got a major upgrade". Only the
// single most recently created `enabled` row is shown at a time; admins keep
// older ones around (disabled) as a simple history rather than deleting.
model Announcement {
  id        String   @id @default(cuid())
  badge     String   @default("UPDATE")
  title     String
  message   String?
  linkUrl   String?
  linkText  String?
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("announcements")
}

// ─── Invoice Generator — customer/company capture ─────────────────────────────
//
// The Invoice Generator tool itself is fully client-side (no account, no
// server-stored invoice content) — this only captures the *metadata* of each
// generated invoice (who it was for, which company issued it) for admin
// analysis, not the invoice document itself. `Company` is deduplicated by
// name+email so the admin dashboard can answer "how many invoices has this
// company generated" — there's no company login, so this is a best-effort
// match on the free-text fields the issuer typed into the editor.

model Company {
  id        String    @id @default(cuid())
  name      String
  email     String?
  vatNumber String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  invoices Invoice[]

  @@unique([name, email])
  @@map("companies")
}

model Invoice {
  id              String   @id @default(cuid())
  invoiceNumber   String
  companyId       String
  customerName    String?
  customerCompany String?
  customerEmail   String?
  currency        String   @default("USD")
  total           Float?
  userId          String?
  createdAt       DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([invoiceNumber])
  @@map("invoices")
}

// ─── Site Analytics ────────────────────────────────────────────────────────────
//
// Lightweight first-party analytics — page views (for visit/unique-visitor
// counts) and per-tool time-on-page. visitorId is the same anonymous cookie
// used for Likes (see src/lib/visitor.ts); userId is populated when signed in.
// Not present locally for anything geo-related since Vercel's edge headers
// don't exist under `next dev`.

model PageView {
  id        String   @id @default(cuid())
  path      String
  visitorId String?
  userId    String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@index([visitorId])
  @@map("page_views")
}

model ToolVisit {
  id         String   @id @default(cuid())
  toolId     String
  visitorId  String?
  userId     String?
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([toolId])
  @@index([createdAt])
  @@map("tool_visits")
}

// ─── Tool Registry ────────────────────────────────────────────────────────────

model Tool {
  id          String   @id
  name        String
  slug        String   @unique
  category    String
  isPremium   Boolean  @default(false)
  isActive    Boolean  @default(true)
  description String?
  icon        String?
  apiProvider String?
  createdAt   DateTime @default(now())

  @@map("tools")
}
